{
  "name": "StatusUpdate",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "traffic",
        "supermarket",
        "beach",
        "parking",
        "public_place",
        "restaurant",
        "clinic",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "structured_data": {
      "type": "object",
      "description": "Category-specific structured fields",
      "properties": {
        "crowd_level": {
          "type": "string",
          "enum": [
            "empty",
            "light",
            "moderate",
            "busy",
            "packed"
          ]
        },
        "wait_minutes": {
          "type": "number"
        },
        "congestion_level": {
          "type": "string",
          "enum": [
            "clear",
            "light",
            "moderate",
            "heavy",
            "standstill"
          ]
        },
        "has_accident": {
          "type": "boolean"
        },
        "road_speed_kmh": {
          "type": "number"
        },
        "wave_height_m": {
          "type": "number"
        },
        "water_quality": {
          "type": "string",
          "enum": [
            "excellent",
            "good",
            "fair",
            "poor"
          ]
        },
        "wind_level": {
          "type": "string",
          "enum": [
            "calm",
            "light",
            "moderate",
            "strong",
            "dangerous"
          ]
        },
        "parking_availability": {
          "type": "string",
          "enum": [
            "available",
            "limited",
            "full"
          ]
        }
      }
    },
    "photo_url": {
      "type": "string"
    },
    "accuracy_score": {
      "type": "number",
      "default": 0
    },
    "confirm_count": {
      "type": "number",
      "default": 0
    },
    "deny_count": {
      "type": "number",
      "default": 0
    },
    "report_count": {
      "type": "number",
      "default": 0
    },
    "status_visibility": {
      "type": "string",
      "enum": [
        "visible",
        "hidden",
        "flagged"
      ],
      "default": "visible"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "location_id",
    "category",
    "title",
    "description"
  ]
}