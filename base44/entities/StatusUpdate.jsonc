{
  "name": "StatusUpdate",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "supermarket",
        "beach",
        "traffic",
        "parking",
        "restaurant",
        "clinic",
        "transport",
        "park",
        "other"
      ]
    },
    "status_level": {
      "type": "string",
      "enum": [
        "Good",
        "Moderate",
        "Bad"
      ]
    },
    "description": {
      "type": "string"
    },
    "confirm_count": {
      "type": "number",
      "default": 0
    },
    "downvote_count": {
      "type": "number",
      "default": 0
    },
    "language_code": {
      "type": "string"
    },
    "report_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "nickname",
    "location_name",
    "category",
    "status_level",
    "description"
  ]
}