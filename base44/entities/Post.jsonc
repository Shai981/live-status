{
  "name": "Post",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "location_name": {
      "type": "string",
      "description": "Mandatory location header"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "supermarket",
        "beach",
        "traffic",
        "parking",
        "restaurant",
        "clinic",
        "transport",
        "park",
        "event",
        "other"
      ]
    },
    "status_level": {
      "type": "string",
      "enum": [
        "Good",
        "Moderate",
        "Bad"
      ]
    },
    "description": {
      "type": "string"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_request": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a status request asking the community"
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "accurate_count": {
      "type": "number",
      "default": 0
    },
    "outdated_count": {
      "type": "number",
      "default": 0
    },
    "wow_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "report_count": {
      "type": "number",
      "default": 0
    },
    "is_hidden": {
      "type": "boolean",
      "default": false
    },
    "language_code": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "location_name"
  ]
}