{
  "name": "StatusRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "supermarket",
        "beach",
        "traffic",
        "parking",
        "restaurant",
        "clinic",
        "transport",
        "park",
        "event",
        "other"
      ]
    },
    "note": {
      "type": "string"
    },
    "reply_count": {
      "type": "number",
      "default": 0
    },
    "is_resolved": {
      "type": "boolean",
      "default": false
    },
    "language_code": {
      "type": "string"
    }
  },
  "required": [
    "location_name"
  ]
}