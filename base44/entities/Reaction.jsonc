      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "reaction_type": {
      "type": "string",
      "enum": [
        "like",
        "accurate",
        "outdated",
        "wow",
        "vote_busy",
        "vote_crowded",
        "vote_moderate",
        "vote_light",
        "vote_empty"
      ]
    }
  },
  "required": [
